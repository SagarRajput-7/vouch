{
  "name": "vouch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/lib/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "samples:generate": "tsx samples/generate.ts",
    "samples:record": "LLM_MODE=record VOUCH_DISABLE_AUTO_DRAIN=true PGLITE_DATA_DIR=:memory: LOCAL_DATA_DIR=.data/record tsx scripts/record-samples.ts",
    "eval": "VOUCH_DISABLE_AUTO_DRAIN=true PGLITE_DATA_DIR=:memory: LOCAL_DATA_DIR=.data/eval tsx scripts/eval.ts",
    "eval:live": "LLM_MODE=live VOUCH_DISABLE_AUTO_DRAIN=true PGLITE_DATA_DIR=:memory: LOCAL_DATA_DIR=.data/eval tsx scripts/eval.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@base-ui/react": "^1.8.0",
    "@electric-sql/pglite": "^0.5.8",
    "@napi-rs/canvas": "^1.0.10",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.104.1",
    "@vercel/blob": "^2.8.0",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.3",
    "geist": "^1.7.2",
    "lucide-react": "^1.50.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.21.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tesseract.js": "^7.0.0",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@better-auth/cli": "^1.4.21",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "pdf-lib": "^1.17.1",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@12.4.1",
  "engines": { "node": ">=24" }
}
